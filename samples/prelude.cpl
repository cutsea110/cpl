right object 1 with ! is
end object;

right object prod(a,b) with pair is
  pi1: prod -> a
  pi2: prod -> b
end object;

let dup  = pair(I,I);
# (a, b) -> (b, a)
let swap = pair(pi2, pi1);
# (a, (b, c)) -> ((a, b), c)
let assocl = pair(pair(pi1,pi1.pi2).pair(pi1,pi2),pi2.pi2);
# ((a, b), c) -> (a, (b, c))
let assocr = pair(pi1.pi1,pair(pi2.pi1,pi2).pair(pi1,pi2));
# (a, (b, c)) -> ((a, b), (a, c))
let distl = pair(pair(pi1,pi1.pi2),pair(pi1,pi2.pi2));
# ((a, b), c) -> ((a, c), (b, c))
let distr = pair(pair(pi1.pi1,pi2),pair(pi2.pi1,pi2));

left object coprod(a,b) with case is
  in1: a -> coprod
  in2: b -> coprod
end object;

# a^b x b -> a
right object exp(a,b) with curry is
  ev: prod(exp,b) -> a
end object;

let uncurry(f) = ev.prod(f,I);

let K  = curry(pi1);
# another style of K combinator
let K'(c) = c.!;
let KI = curry(pi2);
# another style of KI combinator
let KI'(_) = I;
let B  = curry(ev.pair(pi1,ev.pi2).assocr);
# another style of B combinator
let B'(f,g) = ev.pair(f.!,ev.pair(g.!,I));
let S  = curry(ev.pair(ev.pi1,ev.pi2).distr);
# another style of S combinator
let S'(f,g) = ev.pair(ev.pair(f.!,I),ev.pair(g.!,I));

left object bool with if is
  false: 1 -> bool
  true: 1 -> bool
end object;

left object option(a) with maybe is
  none: 1 -> option
  some: a -> option
end object;

left object nat with prn is
  z: 1 -> nat
  s: nat -> nat
end object;

let add  = ev.prod(prn(curry(pi2),curry(s.ev)),I);
# curried version (1 is supplied as pi1)
let cadd = curry(curry(add).pi2).1;
let mul = ev.prod(prn(curry(z.!),curry(add.pair(ev,pi2))),I);
# curried version (1 is supplied as pi1)
let cmul = curry(curry(mul).pi2).1;
let fact  = pi1.prn(pair(s.z,z),pair(mul.pair(s.pi2,pi1),s.pi2));

right object conat with unfold is
  out: conat -> coprod(1, conat)
end object;

let coZ = unfold(in1) : 1 -> conat;
let coS = unfold(in2) : conat -> conat;

let coomega = unfold(in2.I) : 1 -> conat;
# f0: 1 -> *a
# f1: *a -> *a
# embed.z = coZ
# embed.s = coS.embed
let embed = prn(coZ, coS) : nat -> conat;
# anamorphism (coiteration)
let unfoldn(step) = unfold(step) : *a -> conat;

# list
left object list(a) with prl is
  nil: 1 -> list
  cons: prod(a, list) -> list
end object;

let hd = prl(in1, in2.pi1);
let tl = coprod(I,pi2).prl(in1, in2.prod(I,case(nil,cons)));
let mapl(f) = prl(nil,cons.pair(ev.pair(f.!,pi1),pi2));
let lenl = prl(z.!,s.pi2);
let appendl = ev.prod(prl(curry(pi2),curry(cons.pair(pi1.pi1,ev.pair(pi2.pi1,pi2)))),I);
let suml = prl(z, add.pair(pi1,pi2));

# non empty list
left object nel(a) with prnel is
  unit: a -> nel
  cons': prod(a, nel) -> nel
end object;

let hd' = prnel(I,pi1);
let tl' = coprod(!,pi2).prnel(in1,in2.prod(I,case(unit,cons')));
let mapnel(f) = prnel(unit.ev.pair(f.!,I),cons'.pair(ev.pair(f.!,pi1),pi2));
let lennel = prnel(s.z.!,s.pi2);
let appendnel = ev.prod(prnel(curry(cons'.pair(pi1,pi2)),curry(cons'.pair(pi1.pi1,ev.pair(pi2.pi1,pi2)))),I);
let sumnel = prnel(I,add.pair(pi1,pi2));

# coprod(1,a) -> maybe(a)
let toMaybe = case(none, some);

# histomorphism on mybe functor for nat
# histo phi = hd' . u
#   where u Z     = unit (phi none)
#         u (S n) = cons' (phi (some n')) n'
#           where n' = u n
let histo(phi) = hd'.prn(unit.phi.none,cons'.pair(phi.some,I));

# fib with tabulation via histo on option(nel nat)
let fib = histo(maybe(z,add.pair(hd',maybe(s.z,hd').toMaybe.tl')));

